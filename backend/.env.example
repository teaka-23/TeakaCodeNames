NODE_ENV=development
PORT=3001
# Comma-separated origins. On Render, set to the static site URL
# (e.g. https://codenames-web-erca.onrender.com). Avoid * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost

# Persistence of rooms across restarts
#   unset / empty -> in-memory only
#   file          -> snapshot to PERSISTENCE_FILE
# Local default: file under ./data
# Render Free blueprint: file → /tmp/codenames-rooms.json (wiped on sleep)
# Render paid + disk: file → /data/rooms.json
PERSISTENCE_DRIVER=file
PERSISTENCE_FILE=./data/rooms.json

# Seconds-equivalent ms before an empty room is deleted after last WS disconnect
EMPTY_ROOM_GRACE_MS=600000

# Soft WS flood cap (messages per player per window)
WS_RATE_LIMIT=30
WS_RATE_WINDOW_MS=10000

# Default turn clock for new rooms (ms). 0 = no timer.
# Hosts can still override via turnSeconds on create.
TURN_DURATION_MS=60000

# Set true only for local tooling — public room inventory is off by default
ALLOW_ROOM_LIST=false
